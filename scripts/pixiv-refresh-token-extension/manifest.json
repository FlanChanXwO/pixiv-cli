{
  "manifest_version": 3,
  "name": "Pixiv RefreshToken Exporter",
  "description": "Export Pixiv App OAuth refresh_token for pixiv-mcp-server.",
  "version": "0.1.0",
  "action": {
    "default_title": "Pixiv RefreshToken Exporter",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.pixiv.net/post-redirect*"
      ],
      "js": [
        "post_redirect.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://app-api.pixiv.net/*",
    "https://accounts.pixiv.net/*",
    "https://oauth.secure.pixiv.net/*"
  ]
}
