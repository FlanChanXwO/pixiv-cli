.DS_Store

# Go build/test artifacts
/build/
/pixiv-cli
/pixiv-auth
/pixiv
*.test
*.out
coverage/
coverage.txt

# Runtime outputs and local data
downloads/
# Structured E2E evidence may use `downloads` as a case group; only its text
# reports are stored there, while real downloaded media remains outside Git.
!output/runs/**/cases/downloads/
!output/runs/**/cases/downloads/*/
output/runs/**/cases/downloads/*/*
!output/runs/**/cases/downloads/*/report.md
!output/runs/**/cases/downloads/*/stdout.txt
!output/runs/**/cases/downloads/*/stderr.txt
*.db
*.sqlite
*.sqlite3
*.log

# Browser automation tool runtime logs
/.playwright-mcp/

# E2E native-evidence test output
/.native-evidence-test.*/

# Local environment and editor files
.env
.env.*
!.env.example
.idea/
.vscode/

# Temporary/cache files
tmp/
temp/
.cache/
.repo/
__pycache__/
*.py[cod]

# Rust compiler output is machine-specific; verified staticlib/manifest stays tracked.
/internal/media/ugoira/rust/target/

.worktrees/
