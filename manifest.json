{
  "dxt_version": "0.1",
  "name": "pixiv-cli",
  "display_name": "Pixiv CLI",
  "version": "2.0.0",
  "description": "A Go Pixiv CLI and MCP toolset",
  "author": {
    "name": "FlanChanXwO"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FlanChanXwO/pixiv-cli"
  },
  "keywords": ["pixiv", "art", "illustration", "download", "search", "mcp"],
  "license": "MIT",
  "server": {
    "type": "binary",
    "entry_point": "pixiv",
    "mcp_config": {
      "command": "${__dirname}/pixiv",
      "args": ["mcp"],
      "env": {
        "PIXIV_REFRESH_TOKEN": "${user_config.pixiv_refresh_token}",
        "DOWNLOAD_PATH": "${user_config.download_path}",
        "FILENAME_TEMPLATE": "${user_config.filename_template}",
        "https_proxy": "${user_config.proxy_url}"
      }
    }
  },
  "user_config": {
    "pixiv_refresh_token": {
      "type": "string",
      "title": "Pixiv Refresh Token or Cookie with refresh_token",
      "sensitive": true,
      "required": true
    },
    "download_path": {
      "type": "directory",
      "title": "Download Directory",
      "required": false,
      "default": "./downloads"
    },
    "filename_template": {
      "type": "string",
      "title": "Filename Template",
      "required": false,
      "default": "{author} - {title}_{id}"
    },
    "proxy_url": {
      "type": "string",
      "title": "Proxy URL",
      "required": false
    }
  }
}
