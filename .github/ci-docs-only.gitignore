# Git-ignore syntax. A change is documentation-only only when every changed path matches.
# Keep build, dependency, workflow, toolchain, packaging, and release inputs out of this file.
/README.md
/README.*.md
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/CONTRIBUTING.*.md
/.gitignore
/.pre-commit-config.yaml
/.github/CODEOWNERS
/.github/PULL_REQUEST_TEMPLATE.md
/.github/ISSUE_TEMPLATE/**
/docs/**
/changelog/**
/skills/**
/.agents/skills/**
