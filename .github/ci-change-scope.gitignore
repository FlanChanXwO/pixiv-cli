# scripts/ci/classify-change-scope.sh 读取的 ignore 语法：普通模式只算文档改动，
# ? 模式要求 Quality，! 模式要求 Quality + Platform + Container。
/README.md
/README.*.md
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/CONTRIBUTING.*.md
/.gitignore
/.pre-commit-config.yaml
/.github/CODEOWNERS
/.github/ISSUE_TEMPLATE/**
/docs/**
/changelog/**
/skills/**
/.agents/skills/**

?/.github/PULL_REQUEST_TEMPLATE.md
?/.github/ci-change-scope.gitignore
?/.github/workflows/ci.yml
?/.github/workflows/pr-invalid-close.yml
?/.github/workflows/pr-verification.yml
?/scripts/ci/classify-change-scope.sh
?/scripts/pr/**

!/Dockerfile
!/.dockerignore
!/LICENSE
!/go.mod
!/go.sum
!/cmd/**
!/internal/**
!/sdk/**
!/scripts/build/**
!/scripts/ci/race-gate.sh
!/scripts/ci/test-package-release.sh
# pr-metadata.yml 是 smoke controller：它决定 smoke classification、派发两个 worker，
# 并持有 Platform/Container required gate，因此改动它必须真的跑 full smoke。
!/.github/workflows/pr-metadata.yml
!/.github/workflows/container-smoke.yml
!/scripts/build/platform.sh
!/scripts/build-staticlibs*
!/scripts/release/**
!/frontend/**
