# Scoped Git-ignore syntax consumed by scripts/classify-change-scope.sh.
# Plain patterns are documentation-only, ?patterns require Quality only,
# and !patterns require Quality + Platform + Container.
/README.md
/README.*.md
/AGENTS.md
/CLAUDE.md
/CONTRIBUTING.md
/CONTRIBUTING.*.md
/.gitignore
/.pre-commit-config.yaml
/.github/CODEOWNERS
/.github/ISSUE_TEMPLATE/**
/docs/**
/changelog/**
/skills/**
/.agents/skills/**

?/.github/PULL_REQUEST_TEMPLATE.md
?/.github/ci-change-scope.gitignore
?/.github/workflows/ci.yml
?/.github/workflows/pr-invalid-close.yml
?/.github/workflows/pr-verification.yml
?/scripts/classify-change-scope.sh
?/scripts/tests/prverificationworkflow/**
?/tools/internal/verificationpolicy/**
?/tools/prmeta/**
?/tools/verification/**

!/Dockerfile
!/.dockerignore
!/LICENSE
!/THIRD_PARTY_LICENSES.md
!/third_party/licenses/**
!/third_party/rust/**
!/go.mod
!/go.sum
!/cmd/**
!/internal/**
!/sdk/**
!/ci/**
!/tools/platformmatrix/**
# pr-metadata.yml 是 smoke controller：它决定 smoke classification、dispatch 两个
# worker，并持有 Platform/Container required gate，因此改动它必须真的跑 full smoke。
!/.github/workflows/pr-metadata.yml
!/.github/workflows/container-smoke.yml
!/scripts/build-platform.sh
!/scripts/build-staticlibs*
!/scripts/cmd/releaseassets/**
